<style>
  .sthyra-splash { position: fixed; inset: 0; z-index: 2147483000; background: #0b0b0b; display: flex; align-items: center; justify-content: center; cursor: pointer;
    animation: sth-exit .9s cubic-bezier(.77,0,.18,1) 2.6s forwards; }
  html.sthyra-splash-seen .sthyra-splash { display: none; }
  .sthyra-splash--stage { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .sthyra-splash--logo { width: min(410px, 70vw); height: auto; overflow: visible; }
  .sthyra-splash--logo .sth-l { fill: #f4f1ea; opacity: 0; transform: translateY(40%); transform-box: fill-box; filter: blur(6px);
    animation: sth-rise .8s cubic-bezier(.2,.8,.2,1) calc(.25s + var(--i) * 70ms) forwards; }
  .sthyra-splash--logo .sth-l2 { fill: #cfc8ba; }
  .sthyra-splash--rule { width: 0; height: 1px; background: linear-gradient(90deg, transparent, #C9A877, transparent); animation: sth-rule 1s cubic-bezier(.65,0,.35,1) 1.4s forwards; }
  @keyframes sth-rise { to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  @keyframes sth-rule { to { width: min(420px, 70vw); } }
  @keyframes sth-exit { to { transform: translateY(-100%); visibility: hidden; } }
  .sthyra-splash.sthyra-splash_skip { animation: sth-exit .45s cubic-bezier(.77,0,.18,1) forwards; }
  @media (prefers-reduced-motion: reduce) {
    .sthyra-splash, .sthyra-splash * { animation-duration: .01s !important; animation-delay: 0s !important; }
    .sthyra-splash { animation: sth-fade .4s ease 1s forwards !important; }
    @keyframes sth-fade { to { opacity: 0; visibility: hidden; } }
  }
</style>
<%= nonced_javascript_tag do %>
  (function () {
    var key = "sthyra-splash-seen";
    var root = document.documentElement;
    var el = document.getElementById("sthyra-splash");
    var seen = false;
    try { seen = window.sessionStorage.getItem(key) === "1"; } catch (e) {}
    if (seen || root.classList.contains("sthyra-splash-seen")) {
      root.classList.add("sthyra-splash-seen");
      return;
    }
    try { window.sessionStorage.setItem(key, "1"); } catch (e) {}
    var done = function () {
      root.classList.add("sthyra-splash-seen");
      document.removeEventListener("keydown", skip);
    };
    var skip = function () {
      if (!el) return;
      el.classList.add("sthyra-splash_skip");
      setTimeout(done, 450);
    };
    if (el) {
      el.addEventListener("click", skip);
      el.addEventListener("animationend", function (ev) { if (ev.target === el) done(); });
    }
    document.addEventListener("keydown", skip, { once: true });
    setTimeout(done, 4000);
  })();
<% end %>
<% end %>
