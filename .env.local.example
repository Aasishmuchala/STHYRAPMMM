# Sthyra Command Center — environment
# Copy to .env.local and fill from the Supabase dashboard (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used to bootstrap verified users into public.profiles.
SUPABASE_SERVICE_ROLE_KEY=

# KesarCloud Omega gateway — powers the AI Assistant.
# Preferred: the owner sets the key in the app at Settings -> AI Assistant (encrypted in Supabase Vault).
# OMEGA_API_KEY below is an OPTIONAL server-side override (e.g. for cron) and wins if set. Never exposed to the browser.
OMEGA_API_KEY=
OMEGA_BASE_URL=https://omega.kesarcloud.in/v1

# ── Attendance 6am email ─────────────────────────────────────────────────────
# The daily cron (/api/cron/attendance-invite, 6am IST) emails each member a
# one-tap check-in link. It no-ops safely until these are set. Configure them in
# Vercel → Project → Settings → Environment Variables for production.
#
# Email provider (Resend — https://resend.com, free tier). Without a verified
# domain, RESEND_FROM's default (onboarding@resend.dev) only delivers to your own
# Resend-account email. Verify a domain to email everyone.
RESEND_API_KEY=
RESEND_FROM=                       # e.g. "Sthyra <attendance@yourdomain.com>"
# Any random string. Vercel Cron auto-sends it as a Bearer token to authenticate
# the scheduled job; the route rejects requests without it.
CRON_SECRET=
# Public base URL used to build the emailed link (defaults to the Vercel URL).
NEXT_PUBLIC_SITE_URL=

# ── Attendance WhatsApp (Meta Cloud API) ─────────────────────────────────────
# The SAME 6am cron also sends each member the approved attendance template over
# WhatsApp, reusing the same signed check-in token. Server-only — NEVER expose any
# of these via NEXT_PUBLIC_*. The channel no-ops safely until the required vars
# (PHONE_NUMBER_ID + ACCESS_TOKEN + a template name) are set; email is unaffected.
# Direct Meta Graph API only — no Twilio/MSG91/Gupshup/WATI/Interakt/BSP.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Graph API version for the messages endpoint (defaults to v21.0 if unset).
META_GRAPH_API_VERSION=v21.0
# Approved attendance template name + language code. The attendance-specific
# names take precedence; the generic *_TEMPLATE_* names are accepted as fallback.
WHATSAPP_ATTENDANCE_TEMPLATE_NAME=
WHATSAPP_ATTENDANCE_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_NAME=          # fallback if *_ATTENDANCE_* is unset
# WHATSAPP_TEMPLATE_LANG=en        # fallback if *_ATTENDANCE_* is unset
# Country code prepended to bare 10-digit local numbers (defaults to 91 / India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
